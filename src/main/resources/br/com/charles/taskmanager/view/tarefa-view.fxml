<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ComboBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.com.charles.taskmanager.controller.TarefaController"
            stylesheets="@style.css">

    <top>
        <VBox spacing="5" styleClass="cabecalho">
            <Label text="TaskManager" styleClass="titulo-principal"/>
            <Label text="Gerenciador de tarefas com JavaFX, JDBC, SQLite e JUnit"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="10" styleClass="conteudo">

            <TableView fx:id="tabelaTarefas" prefHeight="300">
                <columns>
                    <TableColumn fx:id="colunaId" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="colunaTipo" text="Tipo" prefWidth="150"/>
                    <TableColumn fx:id="colunaTitulo" text="Titulo" prefWidth="180"/>
                    <TableColumn fx:id="colunaDescricao" text="Descricao" prefWidth="250"/>
                    <TableColumn fx:id="colunaStatus" text="Status" prefWidth="100"/>
                    <TableColumn fx:id="colunaPrioridade" text="Prioridade" prefWidth="120"/>
                </columns>
            </TableView>

            <GridPane hgap="10" vgap="10" styleClass="formulario">
                <Label text="Titulo:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="campoTitulo" promptText="Digite o titulo da tarefa"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Descricao:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextArea fx:id="campoDescricao" promptText="Digite a descricao da tarefa"
                          prefRowCount="3"
                          GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <CheckBox fx:id="checkPrioritaria" text="Tarefa prioritaria"
                          GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Prioridade:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <ComboBox fx:id="comboPrioridade"
          promptText="Selecione a prioridade"
          GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </GridPane>

            <HBox spacing="10" styleClass="barra-botoes">
                <Button text="Adicionar" onAction="#adicionarTarefa"/>
                <Button text="Marcar como concluida" onAction="#concluirTarefa"/>
                <Button text="Remover" onAction="#removerTarefa"/>
                <Button text="Limpar campos" onAction="#limparCampos"/>
                <Button text="Atualizar lista" onAction="#carregarTarefas"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>